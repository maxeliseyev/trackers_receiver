# Конфигурация TCP сервера для приёма данных от трекеров
#
# Скопируйте этот файл в .env и настройте под вашу среду:
#   cp .env.example .env

# =============================================================================
# НАСТРОЙКИ СЕРВЕРА
# =============================================================================

SERVER_PORT=36000
SERVER_READ_TIMEOUT=600
SERVER_WRITE_TIMEOUT=30
SERVER_MAX_CONNECTIONS=10000

# =============================================================================
# НАСТРОЙКИ REDIS
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MAX_RETRIES=3

# =============================================================================
# НАСТРОЙКИ ОЧЕРЕДЕЙ
# =============================================================================

QUEUE_CHARGER_NAME=charger
QUEUE_CHARGER_MAX_LEN=2999999
QUEUE_FASTTRACK_NAME=fasttrack
QUEUE_FASTTRACK_MAX_LEN=2999999
