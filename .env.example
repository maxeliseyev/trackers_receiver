# ===== Server Configuration =====
SERVER_PORT=36000
SERVER_READ_TIMEOUT=600
SERVER_WRITE_TIMEOUT=30
SERVER_MAX_CONNECTIONS=100000

# ===== Redis Configuration =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MAX_RETRIES=3

# ===== Queue Configuration =====
QUEUE_CHARGER_NAME=charger
QUEUE_CHARGER_MAX_LEN=2999999
QUEUE_FASTTRACK_NAME=fasttrack
QUEUE_FASTTRACK_MAX_LEN=2999999

# ===== Rate Limiting =====
# Add any load balancer in front of the receiver to the whitelist.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_PER_WINDOW=300
RATE_LIMIT_WINDOW=10
RATE_LIMIT_BLOCK_DURATION=60
RATE_LIMIT_WHITELIST=127.0.0.1,::1
